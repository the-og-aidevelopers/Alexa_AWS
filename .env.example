# Documentation template: uvicorn does not load this file automatically.
# Default: local accounts + SQLite + rules, no AWS SDK calls.
AWS_ENABLED=0
AGENT_WITH_BEDROCK=0
SPEAK_WITH_BEDROCK=0
DOSE_AUTH_PROVIDER=local
DOSE_DB=data/dose_check.sqlite

# Fill these only when deliberately connecting AWS later.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Never commit credentials. Use a profile or workload IAM role.

# Optional: ElevenLabs Scribe v2 speech-to-text (sends each recorded phrase to ElevenLabs).
# Without a key the local Whisper model is used and audio stays on this machine.
ELEVENLABS_API_KEY=
# ELEVENLABS_KEYTERMS=1        # bias Scribe toward household names and medicines (may use extra credits)
# DOSE_TRANSCRIBE_PROVIDER=local  # force the local model even when a key is set

# Optional: Gemini for speech-to-text (gemini-3.5-transcribe) and for choosing the tool from a sentence.
# Audio and text go to Google. Anything that fails falls back to ElevenLabs, local Whisper and the local rules.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # the model that picks the tool
# GEMINI_ROUTING=0                     # keep Gemini transcription but use the local rules to pick tools
# GEMINI_LANGUAGE=en-US
