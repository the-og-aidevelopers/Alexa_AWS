# Copied to /etc/pillow.env on the server (chmod 600). No AWS keys: the instance role provides them.
AWS_ENABLED=1
AWS_REGION=us-east-1

# Storage and sign-in
DOSE_STORAGE=dynamodb
DYNAMODB_TABLE=pillow
DOSE_AUTH_PROVIDER=cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=pillow-123456789012.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=https://dxxxxxxxxxxxx.cloudfront.net/api/auth/cognito-callback
DOSE_SECRET=replace-with-a-long-random-string
DOSE_COOKIE_SECURE=1

# Behind CloudFront
DOSE_PUBLIC_HOST=dxxxxxxxxxxxx.cloudfront.net
DOSE_INTERNAL_PORT=80

# Bedrock chooses the action; the built-in rules are the fallback
AGENT_WITH_BEDROCK=1
AGENT_BEDROCK_FIRST=1
SPEAK_WITH_BEDROCK=0
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Optional cloud transcription. Without any, the browser's own speech recognition is used.
# ELEVENLABS_API_KEY=
